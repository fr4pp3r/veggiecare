# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-test/
venv/
env/
build/
dist/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
tests/__pycache__/

# Local runtime data — never commit sensor readings or logs.
# Keep the dirs themselves tracked so fresh clones/deploys still contain
# data/ and logs/ — systemd ReadWritePaths fails with 226/NAMESPACE if the
# mount points don't exist at service start.
data/*
logs/*
!data/.gitkeep
!logs/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm
*.log

# Raspberry Pi / local environment settings
config/local.yaml

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Tooling indexes
.codegraph/

# OpenCode plans
.omo/