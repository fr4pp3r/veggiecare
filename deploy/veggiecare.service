[Unit]
Description=VeggieCare — Raspberry Pi 5 Smart Plant Monitoring and Control
Documentation=https://github.com/your-org/veggiecare
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
# Runs as the 'veggiecare' account — your Pi login user (set via Raspberry
# Pi Imager / first-boot wizard). Do NOT use 'pi': that user does not exist
# on modern images and systemd fails at the USER step with status=217/USER
# ("Failed to determine user credentials: No such process").
User=veggiecare
Group=veggiecare
WorkingDirectory=/home/veggiecare/veggiecare
Environment=VEGGIECARE_CONFIG=/home/veggiecare/veggiecare/config/config.yaml
Environment=PYTHONPATH=/home/veggiecare/veggiecare
ExecStart=/home/veggiecare/veggiecare/.venv/bin/python /home/veggiecare/veggiecare/app.py --host 0.0.0.0 --port 5000
ExecStop=/bin/kill -TERM $MAINPID
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
TimeoutStopSec=10
TimeoutStartSec=30

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
# NOTE: ProtectHome must stay OFF — it makes /home inaccessible and would
# shadow the ReadWritePaths below, breaking logs/ + data/ writes.
ReadWritePaths=/home/veggiecare/veggiecare/logs /home/veggiecare/veggiecare/data
# GPIO/serial/SPI access
SupplementaryGroups=gpio dialout spi i2c

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=veggiecare

[Install]
WantedBy=multi-user.target